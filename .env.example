# Copy this file to .env and change what you need.
# Command-line options (python main.py --help) override these values.

TIKI_INPUT_FILE=products-0-200000.csv
TIKI_OUTPUT_DIR=output
TIKI_WORKERS=1
TIKI_START_DELAY=0.6
TIKI_MIN_DELAY=0.45
TIKI_MAX_DELAY=10
TIKI_BLOCK_PAUSE=300
TIKI_MAX_BLOCK_PAUSE=900

# auto = pycurl if installed, otherwise the curl binary
TIKI_TRANSPORT=auto
# Only for TIKI_TRANSPORT=curl; leave empty to use curl from PATH
TIKI_CURL_PATH=
